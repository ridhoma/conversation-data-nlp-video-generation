# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter / IPython
.ipynb_checkpoints/
.ipython/
profile_default/
*.sqlite

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hugging Face / model caches
.cache/
*.pt
*.bin

# Archives
*.zip

# Data content — not committed (sensitive). Folder structure is kept via .gitkeep;
# download the actual files separately (see data/README.md).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
